{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch_small",
    "color": { "1": "cyan" },
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "disableLinewrap": true
  },
  "modules": [
    {
      "type": "cpu"
    },
    {
      "type": "display"
    },
    {
      "type": "disk"
    },
    {
      "type": "memory"
    },
    {
      "type": "gpu",
      "detectionMethod": "pci"
    },
    "break",
    {
      "type": "kernel"
    },
    {
      "type": "wm"
    },
    "break",
    {
      "type": "command",
      "key": "OS Age",
      "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
    },
    {
      "type": "uptime"
    },
    "break"
  ]
}